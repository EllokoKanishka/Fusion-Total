# Fusion Reader v2 is local-only unless remote mode is explicitly enabled.
FUSION_READER_BIND_HOST=127.0.0.1
FUSION_READER_ALLOW_REMOTE=0
# FUSION_READER_API_TOKEN=replace-only-if-remote-mode-is-enabled

FUSION_READER_V2_PORT=8010
FUSION_READER_GPU_TTS_PORT=7853
FUSION_READER_CPU_TTS_PORT=7851
FUSION_READER_STT_PORT=8021
FUSION_READER_OLLAMA_PORT=11434

# Optional portable roots. Defaults stay inside the repository except Downloads.
# FUSION_READER_RUNTIME_ROOT=/absolute/path/to/runtime
# FUSION_READER_LIBRARY_ROOT=/absolute/path/to/library
# FUSION_READER_DOWNLOADS_ROOT=/absolute/path/to/exports
# FUSION_READER_CACHE_ROOT=/absolute/path/to/audio-cache
# FUSION_READER_LOG_ROOT=/absolute/path/to/logs

FUSION_READER_ALLTALK_URL=http://127.0.0.1:7853
FUSION_READER_STT_URL=http://127.0.0.1:8021
FUSION_READER_OLLAMA_URL=http://127.0.0.1:11434
FUSION_READER_SEARXNG_URL=http://127.0.0.1:8080
FUSION_READER_EXTERNAL_RESEARCH_PROVIDER=auto
FUSION_READER_STT_PROVIDER=auto
FUSION_READER_VOICE=female_03.wav
FUSION_READER_LANGUAGE=es

FUSION_READER_UPLOAD_MAX_BYTES=134217728
FUSION_READER_PDF_MAX_BYTES=524288000
FUSION_READER_JOB_TTL_SECONDS=21600
FUSION_READER_JOB_MAX_ITEMS=256
FUSION_READER_CACHE_MAX_BYTES=8589934592
FUSION_READER_CACHE_MAX_AGE_DAYS=30
